# Copy to .env and fill in. .env is gitignored; this repo is public.

# Alpaca market data (read-only use: data endpoints only, no trading calls)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex = free single-exchange feed, sip = paid consolidated feed
ALPACA_DATA_FEED=iex

# Finnhub: earnings calendar, analyst upgrades/downgrades
FINNHUB_API_KEY=

# LLM used for catalyst classification (Phase 4)
ANTHROPIC_API_KEY=

# Postgres. Use the dedicated scanner role, never the Apex Engine app role.
GAUNTLET_PG_DSN=postgresql://gauntlet_rw:CHANGE_ME@localhost:5432/apex

# ClickHouse (bars, read-only)
GAUNTLET_CH_URL=http://localhost:8123
GAUNTLET_CH_USER=gauntlet_ro
GAUNTLET_CH_PASSWORD=
