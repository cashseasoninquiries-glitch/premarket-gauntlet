# Copy to .env and fill in. .env is gitignored; this repo is public.

# Alpaca market data. Data endpoints only: this project never places orders.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex = free single-exchange feed, sip = paid consolidated feed
ALPACA_DATA_FEED=iex

# Finnhub: earnings calendar, analyst upgrades/downgrades (Phase 3)
FINNHUB_API_KEY=

# LLM used for catalyst classification (Phase 3)
ANTHROPIC_API_KEY=

# Local SQLite database file. The data/ folder is gitignored.
GAUNTLET_DB_PATH=data/gauntlet.sqlite
